BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/telegram_user.session
TELEGRAM_CHANNELS=
TELEGRAM_POLL_INTERVAL_SECONDS=300
HH_SEARCH_URL=https://hh.ru/search/vacancy
HH_POLL_INTERVAL_SECONDS=600
LINKEDIN_ENABLED=false
LINKEDIN_POLL_INTERVAL_SECONDS=3600
VACANCY_PUSH_INTERVAL_SECONDS=180
AD_BROADCAST_CHECK_INTERVAL_SECONDS=1800

# NOTE: ${VAR} substitution only works inside docker-compose.yml itself, not
# inside values here (this file is read literally, both by docker-compose's
# env_file and by the app's own .env parser) — so the password below must be
# typed out the SAME in both POSTGRES_PASSWORD and inside DATABASE_URL.
POSTGRES_PASSWORD=change-me

# For docker-compose (bot + postgres services on the same network):
DATABASE_URL=postgresql+asyncpg://jobsbot:change-me@postgres:5432/jobsbot
# For running locally without Docker, use SQLite instead:
# DATABASE_URL=sqlite+aiosqlite:///data/bot.db

ADMIN_TELEGRAM_USER_IDS=

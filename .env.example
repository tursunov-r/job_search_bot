BOT_TOKEN=

# Optional — leave both empty to disable Telegram channel parsing entirely
# (HH.ru/LinkedIn parsing works fine without these). Needs a personal
# Telegram account's API credentials from my.telegram.org/apps, not the
# bot's own token — see docs/admin.md if you want to enable this later.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/telegram_user.session
TELEGRAM_POLL_INTERVAL_SECONDS=300
HH_SEARCH_URL=https://hh.ru/search/vacancy
HH_POLL_INTERVAL_SECONDS=600
LINKEDIN_ENABLED=false
LINKEDIN_POLL_INTERVAL_SECONDS=3600
VACANCY_PUSH_INTERVAL_SECONDS=180
AD_BROADCAST_CHECK_INTERVAL_SECONDS=1800

# Postgres connection — these same vars are read both by the app (which
# builds the DSN itself, see config.py::Settings.get_db_url) and by
# docker-compose.yml's postgres service (POSTGRES_USER/PASSWORD/DB), so
# there's exactly one place to set each value, no duplication.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=jobsbot
DB_USER=jobsbot
DB_PASSWORD=change-me

# The one bootstrap super admin — gets every permission automatically, never
# stored in the DB. Everyone else (staff) is added through the bot's /admin
# menu by this account, with individually chosen permissions.
SUPER_ADMIN_TELEGRAM_USER_ID=
